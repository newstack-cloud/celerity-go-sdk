# Sourced by scripts/run-tests.sh before the integration suite.

# Pinned rather than tracking latest, so a runtime release cannot change what a
# test run means without the change being committed.
CELERITY_RUNTIME_VERSION=0.3.0

# The runtime's HTTP port, published to the host, which is where the suite
# sends its requests.
CELERITY_TEST_RUNTIME_PORT=8080
CELERITY_TEST_RUNTIME_URL=http://127.0.0.1:8080

# The valkey the local consumer reads its queues and schedules from, published
# so the suite can publish to a stream.
CELERITY_TEST_VALKEY_PORT=6379

# AWS, emulated, for the provider module suites.
CELERITY_TEST_LOCALSTACK_PORT=4566

# Sourced by scripts/run-tests.sh before the integration suite.

# Pinned rather than tracking latest, so a runtime release cannot change what a
# test run means without the change being committed.
CELERITY_RUNTIME_VERSION=0.3.0

# The runtime's HTTP port, published to the host, which is where the suite
# sends its requests.
CELERITY_TEST_RUNTIME_PORT=8080
CELERITY_TEST_RUNTIME_URL=http://127.0.0.1:8080

# The valkey the local consumer reads its queues and schedules from, published
# so the suite can publish to a stream.
CELERITY_TEST_VALKEY_PORT=6379

# Where the AWS suites point. Emulating is the default and brings its own
# endpoint, http://127.0.0.1:4566, along with the credential an emulator does
# not check, so nothing here has to name one. Set CELERITY_TEST_AWS_ENDPOINT to
# reach an emulator on another port or host.
#
# To run against an account instead, export CELERITY_TEST_AWS_EMULATOR=false
# with a CELERITY_TEST_AWS_RESOURCE_PREFIX, which keeps a run from colliding
# with another sharing the account. Credentials are then the default chain's,
# so a profile or an assumed role, and no endpoint is set.
CELERITY_TEST_AWS_REGION=eu-west-2
CELERITY_TEST_AWS_EMULATOR=true

# The databases the RDS suite reaches, which has no emulator to stand in for it.
# Both engines, since a connection string is built differently for each.
CELERITY_TEST_POSTGRES_PORT=5432
CELERITY_TEST_MYSQL_PORT=3306
